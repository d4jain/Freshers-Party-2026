# ─────────────────────────────────────────────────────────────────────────────
# Freshers’ Party 2026 — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Only variables used by the code are listed. Nothing here is exposed to the
# browser: there are no NEXT_PUBLIC_* variables (the Razorpay key id reaches the
# browser only inside the server's checkout response).
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site (no trailing slash). Used for auth callbacks,
# same-origin (CSRF) checks, email links and metadata.
APP_URL=http://localhost:3000

# development | preview | production. On Vercel this is inferred from
# VERCEL_ENV when unset. Demo mode can never run when this is "production".
APP_ENV=development

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# App runtime: Neon *pooled* connection string (host contains "-pooler").
# Local: `npm run db:local` prints a URL like the one below.
DATABASE_URL=postgres://freshers:freshers-local-only@127.0.0.1:54329/freshers
# Migrations: Neon *direct* (unpooled) connection string. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Required outside development. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Require a verified email before paying (default true). Set false to skip email
# verification entirely: no verification email is sent and users can book right away.
REQUIRE_EMAIL_VERIFICATION=true

# ── Payments (manual UPI) ────────────────────────────────────────────────────
# No payment keys needed. The UPI ID, payee name and QR image are set in
# Admin → Settings (defaults come from src/config/event.ts).

# Development/preview only: open booking before capacity and policies are set.
# Demo bookings/passes are labelled DEMO and rejected at the door. Never active in production.
DEMO_MODE=true

# ── Email ────────────────────────────────────────────────────────────────────
# resend | console | none. "console" (dev only) prints emails to the server log.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Freshers’ Party <tickets@yourdomain.in>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Scheduler & passes ───────────────────────────────────────────────────────
# Bearer secret for /api/cron/reconcile (≥ 16 chars). Vercel Cron sends it automatically.
CRON_SECRET=
# Signs QR passes. Required outside development. Rotating it invalidates issued passes.
TICKET_SIGNING_SECRET=
# Trust X-Forwarded-For for rate-limit keys (true behind Vercel/most proxies).
TRUST_PROXY_HEADERS=true
