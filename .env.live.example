# ─────────────────────────────────────────────────────────────────────────────
# LIVE database settings for the `…:live` commands run from your laptop:
#   npm run db:migrate:live   npm run db:seed:live
#   npm run admin:grant:live -- --email you@example.com --role admin
#   npm run db:studio:live
#
# 1. Copy this file to .env.live (that file is git-ignored — never commit it).
# 2. Paste your Neon DIRECT connection string below, inside the quotes. It looks like
#    postgresql://neondb_owner:xxxx@ep-something-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#    (the host does NOT contain "-pooler").
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL_UNPOOLED=""

# Keep these as they are.
APP_ENV=production
# Must match the value set in Vercel (false = no email verification needed).
REQUIRE_EMAIL_VERIFICATION=false
